    ""
}
fn package_name(index) {
    if index==0 {return "com.android.deskclock";}
    if index==1 {return "com.android.wear.media";}
    if index==2 {return "com.android.settings";}
    if index==3 {return "com.android.settings";}
    if index==4 {return "com.android.settings";}
    if index==5 {return "com.android.wear.assistant";}
    if index==6 {return "com.xopilot.calculator";}
    if index==7 {return "com.xopilot.files";}
    if index==8 {return "com.xopilot.share";}
