// Installed package/component catalog. Removed IDs intentionally return an empty name.
fn package_name(index){
    if index==31 {return "com.xopilot.browser";}
    if index==0 {return "com.android.deskclock";}
    if index==1 {return "com.android.wear.media";}
    if index==2 {return "com.android.settings";}
    if index==3 {return "com.android.settings";}
    if index==4 {return "com.android.settings";}
    if index==5 {return "";}
    if index==6 {return "com.xopilot.calculator";}
    if index==7 {return "com.xopilot.files";}
    if index==8 {return "com.xopilot.share";}
    if index==9 {return "com.android.settings";}
    if index==10 {return "com.xopilot.flashlight";}
    if index==11 {return "com.android.settings";}
    if index==12 {return "com.xopilot.weather";}
    if index==13 {return "com.android.deskclock";}
    if index==14 {return "";}
    if index==15 {return "com.xopilot.calendar";}
    if index==16 {return "";}
    if index==17 {return "";}
    if index==18 {return "com.xopilot.editor";}
    if index==19 {return "com.xopilot.tasks";}
    if index==20 {return "";}
    if index==21 {return "com.xopilot.focus";}
    if index==22 {return "com.xopilot.phone";}
    if index==23 {return "com.xopilot.gallery";}
    if index==24 {return "com.xopilot.btkeyboard";}
    if index==25 {return "com.xopilot.google";}
    if index==26 {return "com.xopilot.googlecalendar";}
    if index==27 {return "com.xopilot.gmail";}
    if index==29 {return "com.xopilot.contacts";}
    if index==30 {return "com.xopilot.messages";}
    if index==28 {return "com.xopilot.translator";}
    ""
}
fn package_label(index){
    if index==31 {return "Браузер";}
    if index==0 {return "Часы";}
    if index==1 {return "Медиа";}
    if index==2 {return "Настройки";}
    if index==3 {return "Связь";}
    if index==4 {return "Об устройстве";}
    if index==5 {return "";}
    if index==6 {return "Калькулятор";}
    if index==7 {return "Файлы";}
    if index==8 {return "Передача файлов";}
    if index==9 {return "Диагностика";}
