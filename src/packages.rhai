// Полный каталог приложений и вложенных компонентов; соответствует App/catalog.json.
fn package_label(index) {
    if index==0 {return "Часы";}
    if index==1 {return "Медиа";}
    if index==2 {return "Настройки";}
    if index==3 {return "Связь";}
    if index==4 {return "Об устройстве";}
    if index==5 {return "Ассистент";}
    if index==6 {return "Калькулятор";}
    if index==7 {return "Файлы";}
    if index==8 {return "Передача файлов";}
    if index==9 {return "Диагностика";}
    if index==10 {return "Фонарик";}
    if index==11 {return "Память и swap";}
    if index==12 {return "Погода";}
    if index==13 {return "Мировое время";}
    if index==14 {return "Дыхание";}
    if index==15 {return "Календарь";}
    if index==16 {return "Конвертер";}
    if index==17 {return "Счётчик";}
    if index==18 {return "Текстовый редактор";}
    if index==19 {return "Задачи";}
    if index==20 {return "Расходы";}
    if index==21 {return "Фокус";}
